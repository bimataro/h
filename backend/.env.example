# =============================================================================
# Pokemon TCG Arbitrage — Backend Environment Variables
# Copy to .env and fill in values
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
RATE_LIMIT_RPM=120
DISABLE_CRON=false

# ---------------------------------------------------------------------------
# API Keys (all optional — free tiers work without keys)
# ---------------------------------------------------------------------------

# pokemontcg.io — optional; raises limit from 1K to 20K req/day
POKEMONTCG_API_KEY=

# PokeTrace — optional; required for authenticated endpoints
POKETRACE_API_KEY=
# Override base URL if self-hosted or different region
POKETRACE_BASE_URL=https://api.poketrace.com/v1

# PokemonPriceTracker — optional; free tier = 100 req/day
# Paid tier ($9.99/mo) = 20K req/day
PPT_API_KEY=
PPT_BASE_URL=https://api.pokemonpricetracker.com/v1

# Exchange rates — optional; open.er-api.com is used if not set
# Get a free key at https://exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Cardmarket CSV
# ---------------------------------------------------------------------------
# Official public export URL — do not change unless Cardmarket updates it
CARDMARKET_CSV_URL=https://www.cardmarket.com/en/Pokemon/Exportrange?idCategory=3&format=csv

# ---------------------------------------------------------------------------
# AI Portfolio
# ---------------------------------------------------------------------------

# Anthropic API key — required for research / scan features
ANTHROPIC_API_KEY=

# Financial Datasets API key — required for stock price / financial data
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai

# ---------------------------------------------------------------------------
# Arbitrage thresholds
# ---------------------------------------------------------------------------
# Minimum ROI % to classify as "buy" signal (default 20)
ROI_THRESHOLD_BUY=20
# Minimum ROI % to classify as "strong-buy" signal (default 50)
ROI_THRESHOLD_STRONG_BUY=50
